# ---------- LAPTOP (local mode, default) ----------
# PETTRACK_PORT=COM8                  # serial port of Arduino 1; leave unset to auto-detect
# PETTRACK_CLOUD_URL=https://your-app.onrender.com   # unset = fully offline, local only
# PETTRACK_SYNC_KEY=long-random-string               # must equal the cloud's value
# PETTRACK_PUBLIC_URL=https://your-app.onrender.com  # what the QR code on the collar opens
# PETTRACK_HOST=127.0.0.1             # only this PC can open the site (default 0.0.0.0 = whole wifi)
# PETTRACK_REQUIRE_LOGIN=1            # ask for a password on the laptop too
# PETTRACK_ADMIN_PASSWORD=change-me

# ---------- CLOUD ----------
# PETTRACK_MODE=cloud
# PETTRACK_ADMIN_PASSWORD=change-me   # or PETTRACK_ADMIN_PASSWORD_HASH (werkzeug hash)
# PETTRACK_SYNC_KEY=long-random-string
# PETTRACK_SECRET_KEY=another-long-random-string
# PETTRACK_DATA_DIR=/data             # must be on a persistent disk

# ---------- optional ----------
# PETTRACK_SYNC_INTERVAL=30  PETTRACK_CLOUD_TIMEOUT=3  PETTRACK_BAUD=9600  PETTRACK_SERIAL=0
